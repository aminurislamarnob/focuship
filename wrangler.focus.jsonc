{
  "$schema": "node_modules/wrangler/config-schema.json",
  // TEMPORARY: serves the site from focus.aminurislam.me until focuship.app is set up.
  // Deploys to the existing `let-me-focus` Worker, which owns that custom domain. Use
  // `npm run deploy:focus` (it builds with NEXT_PUBLIC_SITE_URL so canonicals match).
  // Delete this file and the script once `npm run deploy` serves focuship.app.
  "name": "let-me-focus",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "focus.aminurislam.me", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
