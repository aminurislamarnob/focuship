{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A static-assets-only Worker: Cloudflare serves the `next build` export from its CDN.
  "name": "focuship",
  "compatibility_date": "2026-10-01",
  // Cloudflare creates the DNS record and certificate for this hostname on deploy.
  "routes": [{ "pattern": "focuship.app", "custom_domain": true }],
  // One canonical origin: the PWA's install and offline caches are per-origin.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
